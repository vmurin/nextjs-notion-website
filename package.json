{
  "name": "nextjs-notion-starter-kit",
  "version": "2.0.1",
  "private": true,
  "description": "The perfect starter kit for building beautiful websites with Next.js and Notion.",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "vmurin/nextjs-notion-starter-kit",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "vercel deploy",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test": "run-p test:*",
    "test:lint": "eslint .",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx}' --check"
  },
  "dependencies": {
    "@fisch0920/use-dark-mode": "^2.4.0",
    "@keyvhq/core": "^1.6.9",
    "@keyvhq/redis": "^1.6.10",
    "@react-icons/all-files": "^4.1.0",
    "@texonom/nclient": "^1.5.8",
    "@texonom/ntypes": "^1.5.8",
    "classnames": "^2.5.1",
    "cookies-next": "^4.1.1",
    "date-fns": "^2.28.0",
    "expiry-map": "^2.0.0",
    "fathom-client": "^3.4.1",
    "got": "^14.6.6",
    "katex": "^0.16.28",
    "ky": "^1.14.3",
    "lqip-modern": "^2.2.1",
    "next": "^15.0.3",
    "notion-client": "^7.8.1",
    "notion-types": "^7.8.1",
    "notion-utils": "^7.8.1",
    "p-map": "^7.0.4",
    "p-memoize": "^8.0.0",
    "posthog-js": "^1.249.4",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-body-classname": "^1.3.1",
    "react-dom": "^18.2.0",
    "react-notion-x": "^7.8.1",
    "react-tweet": "^3.3.0",
    "react-use": "^17.6.0",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.0.4",
    "@next/eslint-plugin-next": "^16.1.6",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.15.29",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.23",
    "@types/react-body-classname": "^1.1.10",
    "@types/rss": "^0.0.32",
    "cross-env": "^7.0.2",
    "eslint": "9.39.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "sass": "^1.89.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "overrides": {
    "cacheable-request": {
      "keyv": "npm:@keyvhq/core@~1.6.6"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18"
      }
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "canvas",
      "core-js",
      "protobufjs",
      "unrs-resolver"
    ]
  }
}
